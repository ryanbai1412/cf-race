# Copy to .env.local and fill in (or run ./scripts/setup.sh). See README.md.

# Supabase (Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit (cloud.livekit.io -> project settings)
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Judge service. Local dev: JUDGE_URL=http://localhost:8080 JUDGE_TOKEN=dev
# (make judge-dev). Production: https://cf-race-judge.fly.dev + shared token.
JUDGE_URL=
JUDGE_TOKEN=
