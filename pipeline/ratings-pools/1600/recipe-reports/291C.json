  "semantics": {
    "constraints": "1<=k<=n<=100000; n distinct IPv4 addresses; 4 decimal octets in 0..255 without leading zeroes; header n k, then exactly one IP per line. All IPv4 bit patterns are legal, including 0.0.0.0 and 255.255.255.255.",
    "excludedFeatures": "No interaction, file-I/O, floating answer, custom checker, absent image or multiple-valid-output issue: explicit least-ones tie-break.",
    "independentReference": "Convert every address to a literal 32-character binary string; enumerate all 31 legal prefix lengths, form prefix sets, compare counts and build mask by literal 1/0 strings. Does not use sort, XOR, histogram or production conversion.",
    "maskDomain": "Exactly /1 through /31: at least one leading 1 and at least one trailing 0. /0 and /32 forbidden.",
    "oracle": "Sort unsigned 32-bit addresses. Equal-prefix addresses form contiguous blocks. An adjacent pair splits into separate blocks starting at prefix depth 33-bit_length(a XOR b). Histogram split depths, scan /1..31 accumulating 1+splits and stop at first exact k. O(n log n+32) time, O(n) memory.",
    "uniqueOutput": "Earliest prefix yielding exactly k distinct masked addresses; unique mask for each prefix. If count skips k or never reaches it in /1..31, output -1."
  },
  "sourceMotivatedCoverage": [
    {
      "observation": "Result=set() occurs outside prefix loops and Result.add(A) inside; successive masks may retain old network values. Sample topology across all k and fixed-seed shared-prefix cases are aimed at this pitfall.",
      "submissionId": "4043557"
    },
    {
      "observation": "Loops include all 32 mask lengths including /32, although the statement requires at least one zero bit. Last-bit-differing pairs cover the forbidden endpoint.",
      "submissionIds": [
        "35899504",
        "103571599"
      ]
    },
    {
      "observation": "range(32) with i leading ones includes /0. Single-address and k=1 boundary cases cover the forbidden endpoint.",
      "submissionId": "207810487"
    }
  ],
